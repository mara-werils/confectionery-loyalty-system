NODE_ENV=development
APP_NAME=ConfectioneryLoyalty
APP_VERSION=1.0.0
API_PORT=3001
API_PREFIX=/api/v1

DATABASE_URL="postgresql://user:password@localhost:5432/loyalty_db?schema=public"

JWT_SECRET="change-me-at-least-32-chars-long"
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET="change-me-refresh-at-least-32-chars-long"
JWT_REFRESH_EXPIRES_IN=30d

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

CORS_ORIGIN=http://localhost:5173

TON_NETWORK=testnet
TON_API_KEY=""
TON_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC

# Deploy your own contracts and put addresses here
LOYALTY_TOKEN_ADDRESS=
PARTNER_REGISTRY_ADDRESS=
REDEMPTION_MANAGER_ADDRESS=
REVENUE_DISTRIBUTION_ADDRESS=

ADMIN_MNEMONIC=""
JETTON_DECIMALS="9"

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=""
MINI_APP_URL=

LOG_LEVEL=debug

REDIS_HOST=localhost
REDIS_PORT=6379
